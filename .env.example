# Copy to .env and fill in locally. Do not commit real secrets.

# --- App ---
# python | (reserved)
APP_ENV=development

# --- Database (Phase 4+) ---
# DATABASE_URL=postgresql://pinata:pinata@localhost:5432/pinata_monde

# --- Admin (not implemented yet) ---
# ADMIN_PASSWORD=change-me

# --- Images ---
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_QUOTE=3

# --- Classifier (modular; mock only for now) ---
CLASSIFIER_BACKEND=mock
# CLASSIFIER_BACKEND=rules | vision | custom

# --- Pricing ---
# Real Piñata Monde tariffs are not in the repo yet. Engine uses PLACEHOLDER values.

# --- Odoo (not implemented yet; mock by default) ---
ODOO_MOCK=true
# ODOO_URL=https://example.odoo.com
# ODOO_DB=pinata
# ODOO_USERNAME=
# ODOO_API_KEY=

# --- WhatsApp (not implemented yet; mock/simulator by default) ---
WHATSAPP_MOCK=true
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
