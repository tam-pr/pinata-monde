# Copy to .env and fill in locally. Do not commit real secrets.

# --- App ---
# python | (reserved)
APP_ENV=development

# --- Database (Phase 4+) ---
DATABASE_URL=
# Comma-separated list of allowed CORS origins.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Admin (authentication not implemented yet) ---
# ADMIN_PASSWORD=change-me

# --- Images ---
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_QUOTE=3

# --- Complexity prediction ---
# baseline is a deterministic demo adapter; it is not a trained vision model.
ML_BACKEND=baseline
# ML_BACKEND=mock | unavailable

# --- Pricing ---
# Real Piñata Monde tariffs are not in the repo yet. Engine uses PLACEHOLDER values.

# --- Odoo (mock by default; lead creation follows owner approval) ---
ODOO_MOCK=true
# ODOO_URL=https://example.odoo.com
# ODOO_DB=pinata
# ODOO_USERNAME=
# ODOO_PASSWORD= # Odoo password or API key

# --- WhatsApp (not implemented yet; mock/simulator by default) ---
WHATSAPP_MOCK=true
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
