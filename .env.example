# Copy to .env and fill in locally. Do not commit real secrets.

# --- App ---
# python | (reserved)
APP_ENV=development

# --- Database (Phase 4+) ---
DATABASE_URL=
# Comma-separated list of allowed CORS origins (backend/app/main.py reads
# this — never allow_origins=["*"], since the /admin cookie flow uses
# allow_credentials=True). Only needed if the frontend calls the backend's
# public URL directly (NEXT_PUBLIC_API_URL below is a full https://... URL,
# not "/api"). Sharing through ngrok with a 2nd public backend hostname?
# Append it here, e.g.:
# FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.ngrok-free.app
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (Next.js) ---
# Local dev: keep the default below — the browser calls the backend directly.
# Sharing through ngrok (most ngrok accounts get exactly ONE public hostname,
# so a second one for the backend usually isn't available): set this to the
# relative path "/api" instead. Next's own server then proxies /api/* to
# BACKEND_INTERNAL_URL (below) over plain localhost — see next.config.ts and
# "Sharing your local instance (ngrok)" in README.md.
# Got a 2nd public backend hostname (e.g. a paid plan)? You can instead set
# this to that full https://... URL and skip BACKEND_INTERNAL_URL — just add
# the frontend's ngrok URL to FRONTEND_ORIGIN above for CORS.
# Next.js inlines NEXT_PUBLIC_* vars at dev-server/build start, so restart
# `next dev` after changing this.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only (next.config.ts) — where the /api/* proxy above forwards
# to. Only relevant when NEXT_PUBLIC_API_URL=/api. Never sent to the browser.
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# --- Admin authentication (/admin) ---
# Seeds exactly one admin user on backend startup, if it doesn't exist yet
# (never overwrites an existing user's password on restart). Required for
# /admin to be reachable at all — leave unset to keep it locked.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# Enable when the backend is served over HTTPS (adds the cookie Secure flag).
# SECURE_COOKIES=true

# --- Images ---
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_QUOTE=3

# --- Complexity prediction ---
# baseline is a deterministic demo adapter; it is not a trained vision model.
ML_BACKEND=baseline
# ML_BACKEND=mock | unavailable

# --- Pricing ---
# Real Piñata Monde tariffs are not in the repo yet. Engine uses PLACEHOLDER values.

# --- Odoo (mock by default; lead creation follows owner approval) ---
# ODOO_MOCK=true: create_crm_lead returns a local mock lead, no network call.
# ODOO_MOCK=false: create_crm_lead creates one real crm.lead via Odoo's
# JSON-2 API. Generate the key in Odoo under
# Preferences > Account Security > New API Key.
ODOO_MOCK=true
# ODOO_URL=https://example.odoo.com
# ODOO_DATABASE=
# ODOO_API_KEY=

# --- WhatsApp ---
# "Ordenar por WhatsApp" is a plain wa.me click-to-chat link, not the
# WhatsApp Business API — nothing to configure here. The number itself is
# CONTACT.phoneHref in frontend/lib/nav.ts.
